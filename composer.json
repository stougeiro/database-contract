{
    "name": "stougeiro/database-contract",
    "description": "Minimal, provider-agnostic database contracts for PHP: what a driver must do, never how, so the same code runs over SQL, NoSQL, remote services or files.",
    "type": "library",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "license": "MIT",
    "authors": [
        {
            "name": "stougeiro",
            "email": "sidneytougeiro@gmail.com"
        }
    ],
    "keywords": [
        "php",
        "database",
        "contract",
        "interfaces",
        "abstraction",
        "database-abstraction",
        "database-contract",
        "sql",
        "nosql",
        "agnostic",
        "provider-agnostic",
        "driver"
    ],
    "support": {
        "issues": "https://github.com/stougeiro/database-contract/issues",
        "source": "https://github.com/stougeiro/database-contract"
    },
    "funding": [
        {
            "type": "buymeacoffee",
            "url": "https://www.buymeacoffee.com/stougeiro"
        }
    ],
    "autoload": {
        "psr-4": {
            "STDW\\Contract\\Database\\": "src/"
        }
    },
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2"
    }
}
