{
    "name": "stougeiro/database-contract",
    "description": "Interface-only, engine-neutral contracts for PHP: one foundation so the same application code runs unchanged across SQL, NoSQL, flat-file and HTTP resources.",
    "type": "library",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "license": "MIT",
    "authors": [
        {
            "name": "stougeiro",
            "email": "sidneytougeiro@gmail.com"
        }
    ],
    "keywords": [
        "php",
        "database",
        "contract",
        "interfaces",
        "driver",
        "sql",
        "nosql",
        "flatfile",
        "http-resource",
        "agnostic",
        "dependency-injection"
    ],
    "support": {
        "issues": "https://github.com/stougeiro/database-contract/issues",
        "source": "https://github.com/stougeiro/database-contract"
    },
    "funding": [
        {
            "type": "buymeacoffee",
            "url": "https://www.buymeacoffee.com/stougeiro"
        }
    ],
    "autoload": {
        "psr-4": {
            "STDW\\Contract\\Database\\": "src/"
        }
    },
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2"
    }
}
